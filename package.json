{
	"name": "amp-email-listener",
	"version": "0.2.0",
	"private": true,
	"description": "A single-file Amp plugin that watches a mailbox and wakes an agent when mail arrives.",
	"type": "module",
	"license": "MIT",
	"author": "xAndreiLi",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "bun build index.ts --target=bun --outfile=dist/amp-email-listener.js",
		"self-check": "jiti scripts/self-check.ts",
		"load-check": "jiti scripts/load-check.ts",
		"install-check": "jiti scripts/install-check.ts",
		"test:all": "npm run self-check && npm run load-check && npm run graph-check && npm run auth-check && npm run imap-check && npm run setup-check",
		"mail:auth": "jiti scripts/mail-auth.ts",
		"graph-check": "jiti scripts/graph-check.ts",
		"auth-check": "jiti scripts/auth-check.ts",
		"imap-check": "jiti scripts/imap-check.ts",
		"setup-check": "jiti scripts/setup-check.ts"
	},
	"devDependencies": {
		"@ampcode/plugin": "0.0.0-20261117001159-g1339445",
		"@types/node": "^22.19.19",
		"imapflow": "^2.3.0",
		"jiti": "^2.7.0"
	}
}
